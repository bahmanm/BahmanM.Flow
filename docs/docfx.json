{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "src/public/BahmanM.Flow/BahmanM.Flow.csproj",
            "src/public/BahmanM.Flow.Abstractions/BahmanM.Flow.Abstractions.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "template": [ "default", "api-template" ],
    "content": [
      { "files": [ "api/**/*.yml" ] },
      { "files": "index.md", "src": "api-home", "dest": "." },
      { "files": "toc.yml" }
    ],
    "resource": [
      { "files": [ "assets/**" ] }
    ],
    "dest": "../_site/api",
    "globalMetadata": {
      "_appTitle": "BahmanM.Flow API Reference",
      "_enableSearch": true
    }
  }
}
