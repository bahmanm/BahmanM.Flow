{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "src/public/BahmanM.Flow/BahmanM.Flow.csproj",
            "src/public/BahmanM.Flow.Abstractions/BahmanM.Flow.Abstractions.csproj"
          ]
        }
      ],
      "dest": "obj/docfx-api"
    }
  ],
  "build": {
    "content": [
      { "files": [ "**/*.yml" ], "src": "obj/docfx-api", "dest": "api" },
      { "files": "api-home.md", "dest": "index.md" },
      { "files": "toc.yml" }
    ],
    "resource": [
      { "files": [ "assets/**" ] }
    ],
    "dest": "../_site/api",
    "globalMetadata": {
      "_appTitle": "BahmanM.Flow API Reference",
      "_enableSearch": true
    }
  }
}
