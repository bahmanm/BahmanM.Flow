<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>BahmanM.Flow</PackageId>
    <Description>Clean, Composable Business Logic for .NET</Description>
    <Authors>Bahman Movaqar &lt;Bahman@BahmanM.com&gt;</Authors>
    <PackageTags>workflow;effects;resilience;timeout;structured-concurrency;composition;functional;composition;effect-oriented;fp</PackageTags>
    <PackageProjectUrl>https://github.com/bahmanm/BahmanM.Flow</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bahmanm/BahmanM.Flow</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.NuGet.md</PackageReadmeFile>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Flow</Title>
    <PackageIcon>docs/assets/img/flow-256x256.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BahmanM.Flow.Description.Tests.Unit" />
    <InternalsVisibleTo Include="BahmanM.Flow.Tests.UserAcceptance" />
    <InternalsVisibleTo Include="BahmanM.Flow.Tests.Support" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../README.NuGet.md" Pack="true" PackagePath="" />
    <None Include="../../../docs/assets/img/**" Pack="true" PackagePath="docs/assets/img/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BahmanM.Flow.Abstractions/BahmanM.Flow.Abstractions.csproj" />
    <ProjectReference Include="../../internal/BahmanM.Flow.Shared/BahmanM.Flow.Shared.csproj" />
    <ProjectReference Include="../../internal/BahmanM.Flow.Description/BahmanM.Flow.Description.csproj" />
    <ProjectReference Include="../../internal/BahmanM.Flow.Execution/BahmanM.Flow.Execution.csproj" />
  </ItemGroup>

</Project>
